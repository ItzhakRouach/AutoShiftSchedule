NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cron job auth — set to a strong random secret; Vercel sends it automatically
CRON_SECRET=

# GuardPay integration (values: see GuardPay-Functions/utilities/README.md)
GUARDPAY_APPWRITE_ENDPOINT=
GUARDPAY_APPWRITE_PROJECT_ID=
GUARDPAY_FUNCTION_ID=
GUARDPAY_APPWRITE_API_KEY=
GUARDPAY_IMPORT_SECRET=

# Web push (used by src/lib/push/send.ts + PushToggle.tsx)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Canonical base URL for links in emails/invites (falls back to VERCEL_PROJECT_PRODUCTION_URL)
NEXT_PUBLIC_BASE_URL=

# Claude API (optional AI scheduling layer). The key must belong to the Console
# organization linked to the Max plan, or it bills purchased credits instead of
# the included monthly credit. Without credits the API hard-stops — it is never
# charged to the Claude subscription.
ANTHROPIC_API_KEY=
# App-level circuit breaker (USD/month/workplace) against a runaway retry loop.
AI_MONTHLY_BUDGET_USD=25
# Set to 1 to short-circuit all Claude calls with fixtures (e2e/unit; ignored in production).
AI_FAKE=
